# Portr API (Vercel env vars only — never commit real values)
# Shared TMBC Apps Database (not secret). Share it with the service account as Editor.
GOOGLE_SHEET_ID=1jjv832cA9Y4weW2bRnRpQs8TkHHKIGzLNZWTkiQ6H74
# Tabs are named "<TAB_PREFIX> - <table>" in the shared TMBC Apps Database (default FoodDelivery)
TAB_PREFIX=FoodDelivery
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks
GOOGLE_PRIVATE_KEY=
AUTH_JWT_SECRET=
# Comma-separated; Capacitor apps use https://localhost (Android) and capacitor://localhost
CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:3000
# Optional: protects POST /api/admin/seed
ADMIN_SEED_TOKEN=
# Drive uploads (photos/videos) run as the Portr Google account (themarkkbrandoncollective@gmail.com)
# via OAuth, drive.file scope. Mint the refresh token locally: npm run drive:token -w apps/api
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Folder ID from the Drive folder URL. drive.file can only write into folders this app created
# or that were opened with it, so let `drive:token --create-folder` create it.
DRIVE_FOLDER_ID=
