# Portr apps + website (build time). Unset NEXT_PUBLIC_API_URL = offline demo mode.
# Point at the deployed apps/api Vercel project, e.g. https://portr-api.vercel.app
NEXT_PUBLIC_API_URL=
# Optional: force "demo" or "live"
NEXT_PUBLIC_PORTR_MODE=
# Server keys (Google Sheet, Drive, JWT) live only in the apps/api Vercel project; see apps/api/.env.example
