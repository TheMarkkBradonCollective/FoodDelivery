# Portr — Neon + Cloudflare (no secrets in git)

# Neon Postgres (API + migrations)
DATABASE_URL=

# Cloudflare Worker (set via wrangler secret put — not in wrangler.toml)
JWT_SECRET=

# Client apps + static website build
# Defaults to https://portr-api.themarkkbrandoncollective-2d9.workers.dev when unset
NEXT_PUBLIC_API_URL=
# live (default) or demo (bundled local preview data, no backend)
NEXT_PUBLIC_APP_MODE=live

# GitHub Actions (repository secrets)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# PREVIEW_API_URL=  # optional: baked into website at build time for preview branch
