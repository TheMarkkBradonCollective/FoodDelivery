{
  "name": "porter-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @porter/website",
    "dev:website": "npm run dev -w @porter/website",
    "dev:porter": "npm run dev -w @porter/porter",
    "dev:fastfood": "npm run dev -w @porter/fastfood",
    "dev:runr": "npm run dev -w @porter/runner",
    "dev:vendr": "npm run dev -w @porter/vendr",
    "dev:staff": "npm run dev -w @porter/staff",
    "build:website": "npm run build -w @porter/website",
    "build:porter": "npm run build -w @porter/porter",
    "build:fastfood": "npm run build -w @porter/fastfood",
    "build:runr": "npm run build -w @porter/runner",
    "build:vendr": "npm run build -w @porter/vendr",
    "build:staff": "npm run build -w @porter/staff",
    "build:staff-exe": "npm run build:staff && npm run build -w portr-command && node scripts/stage-staff-exe.mjs",
    "build:all": "npm run build:website && npm run build:fastfood && npm run build:porter && npm run build:runr && npm run build:vendr && npm run build:staff",
    "copy-apks": "bash scripts/copy-apks.sh",
    "build:apks": "node scripts/build-apks.mjs",
    "publish:apk": "node scripts/publish-apk.mjs",
    "release:apk": "npm run build:apks && npm run publish:apk && bash scripts/publish-github-release.sh",
    "cap:sync:fastfood": "npm run cap:sync -w @porter/fastfood",
    "cap:sync:porter": "npm run cap:sync -w @porter/porter",
    "cap:sync:runr": "npm run cap:sync -w @porter/runner",
    "cap:sync:vendr": "npm run cap:sync -w @porter/vendr",
    "cap:sync:staff": "npm run cap:sync -w @porter/staff",
    "android:porter": "npm run android:build -w @porter/porter",
    "android:runr": "npm run android:build -w @porter/runner",
    "android:vendr": "npm run android:build -w @porter/vendr",
    "android:staff": "npm run android:build -w @porter/staff",
    "android:all": "npm run build:apks && npm run publish:apk",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "sync:mbc-catalog": "node scripts/sync-mbc-catalog.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
