# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
apps/*/.next/
apps/*/out/

# android build outputs (keep android/ project source)
apps/*/android/.gradle/
apps/*/android/app/build/
apps/*/android/build/
apps/*/android/*-release.keystore

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
*.zip

# Stray APKs at release root only (use release/apks/ and release/latest/)
/release/*.apk
/release/*.zip

# Versioned + latest APK trees are committed
!release/apks/
!release/apks/**/
!release/apks/**/*.apk
!release/latest/
!release/latest/*.apk
!release/latest/*.zip
